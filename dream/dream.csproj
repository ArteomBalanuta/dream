<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dream</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="animations\BlueCubeGenerator\**" />
    <EmbeddedResource Remove="animations\BlueCubeGenerator\**" />
    <None Remove="animations\BlueCubeGenerator\**" />
  </ItemGroup>

	<ItemGroup>
		<!-- BulletSharp 0.11.1 ships only .NET Framework assets; it runs on net10.0 with the bundled native libbulletc, so NU1701 is expected. -->
		<PackageReference Include="BulletSharp" NoWarn="NU1701" />
		<PackageReference Include="ImGui.NET" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="OpenTK" />
		<PackageReference Include="OpenTK.Windowing.Desktop" />
		<PackageReference Include="SharpGLTF.Core" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<!-- Direct reference so the centrally pinned SQLite native bundle overrides the vulnerable transitive version from Microsoft.Data.Sqlite. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
	</ItemGroup>

  <ItemGroup>
    <None Update="shaders\**\*;animations\**\*;fonts\**\*;config\**\*;ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Kept in the repo for the later tier effects, but nothing loads them (UiAtlasStore.FilePages):
         not copied, which saves 1.19 MB in the build. Remove these two lines when something loads them. -->
    <None Update="ui\items\items_enhanced.png;ui\items\items_mask.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
