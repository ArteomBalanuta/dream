<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="animations\BlueCubeGenerator\**" />
    <EmbeddedResource Remove="animations\BlueCubeGenerator\**" />
    <None Remove="animations\BlueCubeGenerator\**" />
  </ItemGroup>

	<ItemGroup>
		<PackageReference Include="BulletSharp" />
		<PackageReference Include="ImGui.NET" />
		<PackageReference Include="OpenTK" />
		<PackageReference Include="OpenTK.Windowing.Desktop" />
		<PackageReference Include="SharpGLTF.Core" />
		<PackageReference Include="SixLabors.ImageSharp" />
	</ItemGroup>

  <ItemGroup>
    <None Update="shaders\**\*;animations\**\*;fonts\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
