<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dream</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="animations\BlueCubeGenerator\**" />
    <EmbeddedResource Remove="animations\BlueCubeGenerator\**" />
    <None Remove="animations\BlueCubeGenerator\**" />
  </ItemGroup>

	<ItemGroup>
		<!-- BulletSharp 0.11.1 ships only .NET Framework assets; it runs on net10.0 with its native libbulletc, so NU1701 is expected.
		     The package's build assets copy the Windows dll as libbulletc.dll on every OS and add nothing to publish, so they are
		     excluded; the None items below ship exactly libbulletc.dll (win) and libbulletc.so (linux). -->
		<PackageReference Include="BulletSharp" NoWarn="NU1701" ExcludeAssets="build" GeneratePathProperty="true" />
		<PackageReference Include="ImGui.NET" />
		<PackageReference Include="Microsoft.Data.Sqlite" />
		<PackageReference Include="NAudio.Core" />
		<PackageReference Include="NAudio.WinMM" />
		<PackageReference Include="OpenTK" />
		<PackageReference Include="OpenTK.Windowing.Desktop" />
		<PackageReference Include="SharpGLTF.Core" />
		<PackageReference Include="SixLabors.ImageSharp" />
		<!-- Direct reference so the centrally pinned SQLite native bundle overrides the vulnerable transitive version from Microsoft.Data.Sqlite. -->
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
	</ItemGroup>

	<ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('win'))">
		<None Include="$(PkgBulletSharp)\build\net40-client\libbulletc-windows-x64.dll" Link="libbulletc.dll" Visible="false" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
	<ItemGroup Condition="'$(RuntimeIdentifier)' == '' Or $(RuntimeIdentifier.StartsWith('linux'))">
		<None Include="$(PkgBulletSharp)\build\net40-client\libbulletc-linux-x64.so" Link="libbulletc.so" Visible="false" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

  <ItemGroup>
    <None Update="shaders\**\*;animations\**\*;fonts\**\*;audio\**\*;config\**\*;ui\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Kept in the repo for the later tier effects, but nothing loads it (UiAtlasStore.FilePages):
         not copied. Remove these lines when something loads it. -->
    <None Update="ui\items\items_mask.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
