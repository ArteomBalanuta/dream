# The iso sprite set is hashed byte for byte (check_iso determinism): keep LF and never touch the PNGs
tools/ui-assets/iso/**/*.json text eol=lf
tools/ui-assets/iso/*.json text eol=lf
tools/ui-assets/iso/**/*.png binary
tools/ui-assets/iso/*.png binary

# check_terrain compares the committed terrain output with a fresh render byte for byte: keep LF
tools/ui-assets/terrain/*.json text eol=lf
tools/ui-assets/terrain/*.png binary

# The actor and prop GLBs are compared byte for byte against their generators (check_char, check_actors,
# check_props). Git auto-detects them as binary today; pin it, because an eol filter on these would be silent.
dream/animations/**/*.glb binary

# The ground asset manifests are compared byte for byte against their generators (check_ground_*): keep LF
dream/animations/ground/*.json text eol=lf
