<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Dream.Tests</RootNamespace>
    <!-- The suite runs hundreds of allocation-heavy tests at once (SharpGLTF samplers, world
         generation, JSON); the workstation GC stops every test thread for each gen0 collection.
         Server GC collects per core in parallel. Allocation tests read per-thread counters, which
         the GC mode does not change. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dream\dream.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit reads its runner settings (parallel algorithm, thread count) from the output folder. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyDreamNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <DreamNativeRuntime Include="..\dream\bin\$(Configuration)\net10.0\libbulletc*.*" />
      <DreamNativeRuntime Include="..\dream\bin\$(Configuration)\net10.0\BulletSharp.dll.config" />
    </ItemGroup>

    <Copy
      SourceFiles="@(DreamNativeRuntime)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
