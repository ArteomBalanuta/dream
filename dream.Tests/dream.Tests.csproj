<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Dream.Tests</RootNamespace>
    <!-- Deliberately NOT ServerGarbageCollection: the test host uses the same GC mode as production
         (dream.csproj sets nothing, so workstation concurrent GC). The load harness reports GC
         counts, managed memory and tick percentiles, which only mean something under that mode. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dream\dream.csproj" />
  </ItemGroup>

  <!-- Opt-in only: a plain `dotnet test` never restores or loads coverlet. Pass -p:Coverage=true to
       get the collector, and use coverage.runsettings, which turns on IncludeTestAssembly so the
       assertions themselves are instrumented (an Assert. line with zero hits is a dead check). -->
  <ItemGroup Condition="'$(Coverage)' == 'true'">
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- xUnit reads its runner settings (parallel algorithm, thread count) from the output folder. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyDreamNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <DreamNativeRuntime Include="..\dream\bin\$(Configuration)\net10.0\libbulletc*.*" />
      <DreamNativeRuntime Include="..\dream\bin\$(Configuration)\net10.0\BulletSharp.dll.config" />
    </ItemGroup>

    <Copy
      SourceFiles="@(DreamNativeRuntime)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
