<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\dream\dream.csproj" />
  </ItemGroup>

  <Target Name="CopyDreamNativeRuntime" AfterTargets="Build">
    <ItemGroup>
      <DreamNativeRuntime Include="..\dream\bin\$(Configuration)\net10.0\libbulletc*.*" />
      <DreamNativeRuntime Include="..\dream\bin\$(Configuration)\net10.0\BulletSharp.dll.config" />
    </ItemGroup>

    <Copy
      SourceFiles="@(DreamNativeRuntime)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
